NODE_ENV=production
PORT=3001
JWT_SECRET=replace-with-a-production-secret
ALLOWED_ORIGINS=https://app.example.com
DATA_DIR=/var/lib/royalties-claims/data
UPLOAD_DIR=/var/lib/royalties-claims/uploads
MAX_FILE_SIZE=5242880
DATABASE_URL=postgres://app_user:strong_password@prod-db-host:5432/royalties_claim_production
OBJECT_STORAGE_BUCKET=royalties-claims-prod
OBJECT_STORAGE_ENDPOINT=https://storage.example.com
APP_URL=https://app.example.com
