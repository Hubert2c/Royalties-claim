NODE_ENV=staging
PORT=3001
JWT_SECRET=replace-with-a-staging-secret
ALLOWED_ORIGINS=https://staging.example.com
DATA_DIR=./data
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
DATABASE_URL=postgres://user:password@staging-db-host:5432/royalties_claim_staging
OBJECT_STORAGE_BUCKET=royalties-claims-staging
OBJECT_STORAGE_ENDPOINT=https://storage.example.com
APP_URL=https://staging.example.com
