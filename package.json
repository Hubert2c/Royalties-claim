{
  "name": "royalty-hub",
  "version": "3.0.0",
  "description": "Royalty Hub - prototype of a government-administered National Music Royalty Tracking Platform (capstone, ALU).",
  "main": "server.js",
  "scripts": {
    "start": "node start-all.js",
    "dev": "node start-all.js",
    "start:api": "node server.js",
    "start:artist": "node artist-server.js",
    "start:licensee": "node licensee-server.js",
    "test": "node --test \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\"",
    "reset-db": "node -e \"for (const f of ['','-wal','-shm']) require('fs').rmSync('data/royalty_hub.db'+f,{force:true});console.log('Demo database deleted - it is recreated on next start.')\"",
    "vercel:deploy": "vercel --prod",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:load": "node tests/performance/load-test.js",
    "test:bench": "node tests/performance/algorithm-benchmark.js",
    "test:browsers": "node tests/compatibility/browser-check.js",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=22.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "autocannon": "^8.0.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "pidusage": "^4.1.0"
  }
}
